{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gitfoundry:extension-manifest:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "const": "1"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}/[a-z][a-z0-9-]{0,39}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "api_version": {
      "const": "1"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "worker",
            "container",
            "remote"
          ]
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_./-]+$"
        },
        "image": {
          "type": "string",
          "pattern": "^.+@sha256:[a-f0-9]{64}$"
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "provider_key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "kind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "worker"
              }
            }
          },
          "then": {
            "required": [
              "entrypoint"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "container"
              }
            }
          },
          "then": {
            "required": [
              "image"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "remote"
              }
            }
          },
          "then": {
            "required": [
              "endpoint",
              "provider_key_id"
            ]
          }
        }
      ]
    },
    "capabilities": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "audit.export",
              "audit.read",
              "batch.execute",
              "check.read",
              "check.write",
              "comment.admin",
              "comment.read",
              "comment.write",
              "directory.admin",
              "directory.read",
              "directory.write",
              "environment.admin",
              "environment.read",
              "environment.write",
              "event.admin",
              "event.read",
              "event.write",
              "extension.admin",
              "extension.capabilities.approve",
              "extension.install",
              "extension.invoke",
              "extension.read",
              "extension.write",
              "fleet.admin",
              "fleet.read",
              "identity.admin",
              "identity.connections.manage",
              "identity.groups.map",
              "identity.read",
              "identity.write",
              "issue.admin",
              "issue.read",
              "issue.write",
              "migration.activate",
              "migration.admin",
              "migration.launch",
              "network.fetch",
              "notification.admin",
              "notification.read",
              "notification.write",
              "oauth.admin",
              "operation.cancel",
              "operation.read",
              "permission.admin",
              "permission.read",
              "permission.write",
              "project.admin",
              "project.read",
              "project.write",
              "pull_request.admin",
              "pull_request.merge",
              "pull_request.read",
              "pull_request.write",
              "quota.manage",
              "release.admin",
              "release.read",
              "release.write",
              "repository.admin",
              "repository.read",
              "repository.write",
              "review.admin",
              "review.read",
              "review.write",
              "role.definitions.manage",
              "run.admin",
              "run.cancel",
              "run.dispatch",
              "run.read",
              "run.write",
              "runner.pool.manage",
              "search.read",
              "secret.admin",
              "secret.read_metadata",
              "secret.use",
              "secret.write",
              "service.identity.manage",
              "tenant.admin",
              "tenant.read",
              "tenant.settings.manage",
              "ui.panel"
            ]
          },
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "repository_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1000,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "environment_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1000,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "connection_aliases": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1000,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "tenant_wide": {
                "type": "boolean"
              }
            },
            "required": [],
            "anyOf": [
              {
                "required": [
                  "repository_ids"
                ]
              },
              {
                "required": [
                  "environment_ids"
                ]
              },
              {
                "required": [
                  "connection_aliases"
                ]
              },
              {
                "required": [
                  "tenant_wide"
                ],
                "properties": {
                  "tenant_wide": {
                    "const": true
                  }
                }
              }
            ]
          }
        },
        "required": [
          "action",
          "resources"
        ]
      }
    },
    "egress": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "hostname": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]+$"
          },
          "ports": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "methods": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "GET",
                "HEAD",
                "POST",
                "PUT",
                "PATCH",
                "DELETE"
              ]
            }
          },
          "connection_alias": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "hostname",
          "ports",
          "methods"
        ]
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "wall_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "memory_mib": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12288
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      },
      "required": [
        "cpu_ms",
        "wall_ms",
        "memory_mib",
        "concurrency",
        "output_bytes"
      ]
    },
    "hooks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z_]+(?:\\.[a-z_]+)+\\.pre$"
          },
          "handler": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "required": {
            "type": "boolean"
          },
          "priority": {
            "type": "integer",
            "minimum": -10000,
            "maximum": 10000
          },
          "deadline_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          },
          "input_schema_version": {
            "const": "1"
          },
          "output_schema_version": {
            "const": "1"
          }
        },
        "required": [
          "name",
          "handler",
          "required",
          "priority",
          "deadline_ms",
          "input_schema_version",
          "output_schema_version"
        ]
      }
    },
    "events": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z_]+(?:\\.[a-z_]+)+$"
            }
          },
          "handler": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "event_version": {
            "const": "1"
          }
        },
        "required": [
          "types",
          "handler",
          "event_version"
        ]
      }
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cli": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "command": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "handler": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "input_schema": {
                "type": "object"
              },
              "output_schema": {
                "type": "object"
              }
            },
            "required": [
              "command",
              "handler",
              "description",
              "input_schema",
              "output_schema"
            ]
          }
        },
        "mcp": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "operation": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "handler": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "input_schema": {
                "type": "object"
              },
              "output_schema": {
                "type": "object"
              },
              "effect": {
                "enum": [
                  "read",
                  "write",
                  "destructive"
                ]
              },
              "idempotent": {
                "type": "boolean"
              }
            },
            "required": [
              "operation",
              "handler",
              "description",
              "input_schema",
              "output_schema",
              "effect",
              "idempotent"
            ]
          }
        },
        "ui": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "slot": {
                "enum": [
                  "repository.tab",
                  "pull_request.sidebar",
                  "pull_request.action",
                  "issue.panel",
                  "run.summary",
                  "tenant.settings",
                  "migration.report"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "asset": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "csp": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "connect_src": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^https://"
                    }
                  },
                  "img_src": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^https://"
                    }
                  }
                }
              }
            },
            "required": [
              "slot",
              "name",
              "asset",
              "csp"
            ]
          }
        },
        "workflow_steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "handler": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "input_schema": {
                "type": "object"
              },
              "output_schema": {
                "type": "object"
              },
              "timeout_ms": {
                "type": "integer",
                "minimum": 1
              },
              "effect": {
                "enum": [
                  "read",
                  "write",
                  "destructive"
                ]
              }
            },
            "required": [
              "name",
              "handler",
              "input_schema",
              "output_schema",
              "timeout_ms",
              "effect"
            ]
          }
        }
      },
      "required": []
    },
    "oauth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inbound": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "client_type": {
                "enum": [
                  "public",
                  "confidential"
                ]
              },
              "redirect_uris": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "scopes": {
                "type": "array",
                "items": {
                  "enum": [
                    "audit.export",
                    "audit.read",
                    "batch.execute",
                    "check.read",
                    "check.write",
                    "comment.admin",
                    "comment.read",
                    "comment.write",
                    "directory.admin",
                    "directory.read",
                    "directory.write",
                    "environment.admin",
                    "environment.read",
                    "environment.write",
                    "event.admin",
                    "event.read",
                    "event.write",
                    "extension.admin",
                    "extension.capabilities.approve",
                    "extension.install",
                    "extension.invoke",
                    "extension.read",
                    "extension.write",
                    "fleet.admin",
                    "fleet.read",
                    "identity.admin",
                    "identity.connections.manage",
                    "identity.groups.map",
                    "identity.read",
                    "identity.write",
                    "issue.admin",
                    "issue.read",
                    "issue.write",
                    "migration.activate",
                    "migration.admin",
                    "migration.launch",
                    "network.fetch",
                    "notification.admin",
                    "notification.read",
                    "notification.write",
                    "oauth.admin",
                    "operation.cancel",
                    "operation.read",
                    "permission.admin",
                    "permission.read",
                    "permission.write",
                    "project.admin",
                    "project.read",
                    "project.write",
                    "pull_request.admin",
                    "pull_request.merge",
                    "pull_request.read",
                    "pull_request.write",
                    "quota.manage",
                    "release.admin",
                    "release.read",
                    "release.write",
                    "repository.admin",
                    "repository.read",
                    "repository.write",
                    "review.admin",
                    "review.read",
                    "review.write",
                    "role.definitions.manage",
                    "run.admin",
                    "run.cancel",
                    "run.dispatch",
                    "run.read",
                    "run.write",
                    "runner.pool.manage",
                    "search.read",
                    "secret.admin",
                    "secret.read_metadata",
                    "secret.use",
                    "secret.write",
                    "service.identity.manage",
                    "tenant.admin",
                    "tenant.read",
                    "tenant.settings.manage",
                    "ui.panel"
                  ]
                }
              }
            },
            "required": [
              "name",
              "client_type",
              "redirect_uris",
              "scopes"
            ]
          }
        },
        "outbound": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "provider_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "connection_alias": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "provider_scopes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            },
            "required": [
              "provider_id",
              "connection_alias",
              "provider_scopes"
            ]
          }
        }
      },
      "required": []
    },
    "config_schema": {
      "type": "object"
    }
  },
  "required": [
    "manifest_version",
    "name",
    "version",
    "api_version",
    "description",
    "runtime",
    "capabilities",
    "egress",
    "limits",
    "hooks",
    "events",
    "contributions",
    "oauth",
    "config_schema"
  ]
}
