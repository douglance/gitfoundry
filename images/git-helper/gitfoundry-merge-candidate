    tenant_id => $ctx->{tenant_id},
    repository_id => $ctx->{repository_id},
    operation_id => $ctx->{operation_id},
    pull_request_id => $ctx->{pull_request_id},
    pull_request_version => $ctx->{pull_request_version},
    method => $ctx->{method},
    head_sha => $ctx->{head_sha},
    base_sha => $ctx->{base_sha},
    candidate_oid => $p->{candidate_oid},
    candidate_tree => $p->{candidate_tree},
    candidate_bytes_sha256 => $p->{candidate_bytes_sha256},
    git_version => $git_version,
    state_ref => "merge-candidates/requests/$ctx->{request_sha256}/manifest.json",
    original_to_rebased => $p->{original_to_rebased},
  };
}

sub emit_failure_ctx {
  my ($ctx, $status, $diagnostics, $git_version) = @_;
  $git_version //= '2.39.5';
  my $result = {
    frame => $result_frame,
    ok => JSON::PP::false,
    status => $status,
    tenant_id => $ctx->{tenant_id},
    repository_id => $ctx->{repository_id},
    operation_id => $ctx->{operation_id},
    pull_request_id => $ctx->{pull_request_id},
    pull_request_version => $ctx->{pull_request_version},
    method => $ctx->{method},
    head_sha => $ctx->{head_sha},
    base_sha => $ctx->{base_sha},
    git_version => $git_version,
    state_ref => "merge-candidates/$status.json",
    diagnostics => $diagnostics,
  };
