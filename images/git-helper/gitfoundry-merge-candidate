sub emit_failure {
  my ($r, $status, $diagnostics, $git_version, $state_ref) = @_;
  my $result = {
    frame => $result_frame, ok => JSON::PP::false, status => $status,
    tenant_id => ($r->{tenant_id} // 'tenant-a'), repository_id => ($r->{repository_id} // 'repo-a'), operation_id => ($r->{operation_id} // 'op-a'),
    pull_request_id => ($r->{pull_request_id} // 'pr-a'), pull_request_version => ($r->{pull_request_version} // 1), method => ($r->{method} // 'merge'),
    head_sha => (($r->{head_sha} && $r->{head_sha} =~ /\A[0-9a-f]{40}\z/) ? $r->{head_sha} : '0' x 40),
    base_sha => (($r->{base_sha} && $r->{base_sha} =~ /\A[0-9a-f]{40}\z/) ? $r->{base_sha} : '0' x 40),
    git_version => $git_version, state_ref => $state_ref, diagnostics => $diagnostics,
  };
  print encode_json($result) . "\n";
}

sub git_stdout { my ($ctx, @args) = @_; my ($code, $out) = git_capture($ctx, @args); die "git failed @args\n" if $code != 0; return $out; }
sub git_stdout_bytes { git_stdout(@_) }
sub run_git_ok { my ($ctx, @args) = @_; my $code = run_git($ctx, @args); die "git failed @args\n" if $code != 0; }
sub run_git { my ($ctx, @args) = @_; return run_git_env({}, $ctx, @args); }
sub git_capture { my ($ctx, @args) = @_; return git_capture_env({}, $ctx, @args); }

sub git_stdout_input {
  my ($extra_env, $ctx, $input, @args) = @_;
  my ($code, $out) = git_capture_env($extra_env, $ctx, @args, { input => $input });
  die "git failed @args\n" if $code != 0;
  return $out;
}

sub validate_manifest_reuse {
  my ($ctx, $manifest, $expected_sha) = @_;
  die 'manifest request mismatch' unless ($manifest->{request_sha256} // '') eq $expected_sha;
  for my $field (qw(method head_sha base_sha candidate_oid candidate_tree candidate_bytes_sha256 bundle_sha256 pack_file result)) {
    die "manifest missing $field" unless defined $manifest->{$field};
  }
  die 'manifest method mismatch' unless $manifest->{method} eq $ctx->{method};
  die 'manifest head mismatch' unless $manifest->{head_sha} eq $ctx->{head_sha};
  die 'manifest base mismatch' unless $manifest->{base_sha} eq $ctx->{base_sha};
  die 'manifest result invalid' unless ref($manifest->{result}) eq 'HASH';
  validate_manifest_result($ctx, $manifest, $expected_sha);
  my $canonical = JSON::PP->new->canonical(1);
  die 'manifest reviewed diff mismatch' unless ref($manifest->{reviewed_diff}) eq 'HASH' && $canonical->encode($manifest->{reviewed_diff}) eq $canonical->encode(reviewed_diff_evidence($ctx));
  my $request_dir = File::Spec->catdir($ctx->{state_dir_abs}, 'requests', $expected_sha);
  my $raw_path = File::Spec->catfile($request_dir, 'candidate.commit');
  validate_state_file($request_dir, $raw_path);
  validate_state_file($request_dir, $manifest->{pack_file});
  die 'manifest pack digest mismatch' unless sha256_hex(slurp($manifest->{pack_file})) eq $manifest->{bundle_sha256};
  die 'manifest persisted raw digest mismatch' unless sha256_hex(slurp($raw_path)) eq $manifest->{candidate_bytes_sha256};
  my $raw = git_stdout_bytes($ctx, 'cat-file', 'commit', $manifest->{candidate_oid});
  die 'manifest raw digest mismatch' unless sha256_hex($raw) eq $manifest->{candidate_bytes_sha256};
  die 'manifest persisted raw mismatch' unless $raw eq slurp($raw_path);
  my $tree = git_stdout($ctx, 'rev-parse', "$manifest->{candidate_oid}^{tree}");
  chomp $tree;
  die 'manifest tree mismatch' unless $tree eq $manifest->{candidate_tree};
}

sub validate_manifest_result {
  my ($ctx, $manifest, $expected_sha) = @_;
  my $result = $manifest->{result};
  my %expected = (
    frame => $result_frame,
    status => 'prepared',
    tenant_id => $ctx->{tenant_id},
    repository_id => $ctx->{repository_id},
    operation_id => $ctx->{operation_id},
    pull_request_id => $ctx->{pull_request_id},
    pull_request_version => $ctx->{pull_request_version},
    method => $ctx->{method},
    head_sha => $ctx->{head_sha},
    base_sha => $ctx->{base_sha},
    candidate_oid => $manifest->{candidate_oid},
    candidate_tree => $manifest->{candidate_tree},
    candidate_bytes_sha256 => $manifest->{candidate_bytes_sha256},
    git_version => $manifest->{git_version},
    state_ref => "merge-candidates/requests/$expected_sha/manifest.json",
  );
  die 'manifest result ok mismatch' unless $result->{ok};
  for my $field (keys %expected) {
    die "manifest result $field mismatch" unless defined $result->{$field} && "$result->{$field}" eq "$expected{$field}";
  }
  die 'manifest rebase map mismatch' unless maps_equal($result->{original_to_rebased}, $manifest->{original_to_rebased});
}

sub maps_equal {
  my ($a, $b) = @_;
  $a = [] unless defined $a;
  $b = [] unless defined $b;
  if (ref($a) eq 'ARRAY' || ref($b) eq 'ARRAY') {
    return 0 unless ref($a) eq 'ARRAY' && ref($b) eq 'ARRAY' && @$a == @$b;
    for my $i (0..$#$a) {
      return 0 unless ref($a->[$i]) eq 'HASH' && ref($b->[$i]) eq 'HASH';
      return 0 unless ($a->[$i]{original} // '') eq ($b->[$i]{original} // '');
      return 0 unless ($a->[$i]{rebased} // '') eq ($b->[$i]{rebased} // '');
    }
    return 1;
  }
  return 0 unless ref($a) eq 'HASH' && ref($b) eq 'HASH';
  my @ak = sort keys %$a;
  my @bk = sort keys %$b;
  return 0 unless join("\0", @ak) eq join("\0", @bk);
  for my $key (@ak) { return 0 unless defined $b->{$key} && $a->{$key} eq $b->{$key}; }
  return 1;
}

sub validate_state_file {
  my ($request_dir, $path) = @_;
  die 'state path missing' unless defined $path && length($path) > 0;
  die 'state path unsafe' if $path =~ /\0/ || index($path, "$request_dir/") != 0;
  validate_path_chain($request_dir);
  die 'state file missing' unless -f $path;
  die 'state file symlink' if -l $path;
  die 'state file not canonical' unless (abs_path($path) // '') eq $path;
  my @stat = stat($path);
  die 'state file linked' unless @stat && $stat[3] == 1;
}

sub validate_existing_state_chain {
  my ($path) = @_;
  my $cur = '';
  for my $part (split m{/+}, $path) {
    next if $part eq '';
    die 'state component unsafe' if $part eq '.' || $part eq '..';
    $cur .= "/$part";
    die 'state component symlink' if -l $cur;
    die 'state component not directory' if -e $cur && !-d $cur;
  }
}

sub atomic_write_file {
  my ($path, $data) = @_;
  my $tmp = "$path.tmp.$$";
  write_file($tmp, $data);
  rename $tmp, $path or die "rename $tmp $path: $!";
}

sub git_capture_env {
  my ($extra_env, $ctx, @args) = @_;
  my $opts = (ref($args[-1]) eq 'HASH') ? pop @args : {};
  my $err = gensym;
  local %ENV = git_env($extra_env);
  my $pid = open3(my $in, my $out, $err, 'git', safe_git_args(@args));
  if (exists $opts->{input}) { print {$in} $opts->{input}; }
  close $in;
  my $selector = IO::Select->new($out, $err);
  my %buffers = (stdout => '', stderr => '');
  my %names = (fileno($out) => 'stdout', fileno($err) => 'stderr');
  while (my @ready = $selector->can_read) {
    for my $fh (@ready) {
      my $chunk = '';
      my $bytes = sysread($fh, $chunk, 8192);
      if (!defined $bytes) { next; }
      if ($bytes == 0) { $selector->remove($fh); close $fh; next; }
      my $name = $names{fileno($fh)} // 'stderr';
      $buffers{$name} .= $chunk;
      die 'git output exceeds helper bound' if length($buffers{$name}) > 1048576;
    }
  }
  waitpid($pid, 0);
  my $code = $? >> 8;
  return ($code, $buffers{stdout}, $buffers{stderr});
}

sub run_git_env {
  my ($extra_env, $ctx, @args) = @_;
  my ($code) = git_capture_env($extra_env, $ctx, @args);
  return $code;
}

sub safe_git_args {
  return ('-c', 'core.hooksPath=/dev/null', '-c', 'core.attributesFile=/dev/null', '-c', 'commit.gpgsign=false', '-c', 'tag.gpgsign=false', '-c', 'log.showSignature=false', '-c', 'protocol.allow=never', '-c', 'protocol.file.allow=never', '-c', 'protocol.ext.allow=never', '-c', 'gc.auto=0', '-c', 'maintenance.auto=false', @_);
}

sub git_env {
  my ($extra) = @_;
  return (%ENV, GIT_CONFIG_NOSYSTEM => '1', GIT_CONFIG_GLOBAL => '/dev/null', GIT_CONFIG_SYSTEM => '/dev/null', GIT_ATTR_NOSYSTEM => '1', GIT_ATTR_SOURCE => $empty_tree, GIT_CEILING_DIRECTORIES => '/work', GIT_TERMINAL_PROMPT => '0', GIT_NO_REPLACE_OBJECTS => '1', GIT_ALTERNATE_OBJECT_DIRECTORIES => '', %$extra);
}

sub has_unqualified_alternates {
  my ($ctx) = @_;
  my $path = File::Spec->catfile($ctx->{trusted_git_dir}, '.git', 'objects', 'info', 'alternates');
  return -s $path ? 1 : 0;
}

sub object_is_commit { my ($ctx, $oid) = @_; return run_git($ctx, 'cat-file', '-e', "$oid^{commit}") == 0; }

sub helper_error_code {
  my ($error) = @_;
  $error =~ s/[^A-Za-z0-9_:-]+/_/g;
  $error = lc $error;
  $error =~ s/\A_+//;
  $error =~ s/_+\z//;
  $error = substr($error, 0, 48);
  return $error =~ /\A[a-z]/ ? $error : 'helper_error';
}

sub validate_path_chain {
  my ($path) = @_;
  my @parts = split m{/+}, $path;
  my $cur = '';
  for my $part (@parts) {
    next if $part eq '';
    $cur .= "/$part";
    die 'path symlink' if -l $cur;
    die 'path missing' unless -d $cur;
  }
}

sub validate_parent_chain {
  my ($path) = @_;
  my $parent = $path;
  $parent =~ s{/[^/]+\z}{};
  validate_path_chain($parent);
}

sub safe_abs_path { my ($v) = @_; die 'bad path' unless defined($v) && $v =~ m{\A/work/[A-Za-z0-9_.:-]+/[A-Za-z0-9_.:-]+/[A-Za-z0-9_.:-]+/(trusted-git|merge-candidates|source-compare)\z}; return $v; }
sub safe_id { my ($v) = @_; die 'bad id' unless defined($v) && $v =~ /\A[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}\z/; return $v; }
sub oid { my ($v) = @_; die 'bad oid' unless defined($v) && $v =~ /\A[0-9a-f]{40}\z/; return $v; }
sub method { my ($v) = @_; die 'bad method' unless defined($v) && $v =~ /\A(?:merge|squash|rebase|fast_forward)\z/; return $v; }
sub positive_int { my ($v) = @_; die 'bad int' unless defined($v) && $v =~ /\A[1-9][0-9]*\z/; return 0 + $v; }
sub bounded_text { my ($v, $max) = @_; die 'bad text' unless defined($v) && !ref($v) && length($v) > 0 && length($v) <= $max && index($v, "\0") < 0; return $v; }
sub required_literal { my ($got, $want) = @_; die 'bad literal' unless defined($got) && $got eq $want; }
sub slurp {
  my ($path) = @_;
  sysopen(my $fh, $path, O_RDONLY | O_NOFOLLOW) or die "read $path: $!";
  my @stat = stat($fh);
  die 'read linked state file' unless @stat && S_ISREG($stat[2]) && $stat[3] == 1;
  binmode $fh;
  local $/;
  return <$fh>;
}
sub write_file {
  my ($path, $data) = @_;
  my $parent = $path;
  $parent =~ s{/[^/]+\z}{};
  validate_path_chain($parent);
  sysopen(my $fh, $path, O_WRONLY | O_CREAT | O_NOFOLLOW, 0600) or die "write $path: $!";
  my @stat = stat($fh);
  die 'write linked state file' unless @stat && S_ISREG($stat[2]) && $stat[3] == 1;
  binmode $fh;
  truncate($fh, 0) or die "truncate $path: $!";
  print {$fh} $data or die "write bytes $path: $!";
  close $fh or die "close $path: $!";
}
sub die_text { print STDERR "gitfoundry-merge-candidate: $_[0]\n"; exit 64; }
